<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        x:Class="TpCalculatrice.MainWindow"
        Title="Calculatrice" Width="300" Height="400">

    <Window.Styles>
        <Style Selector="Button">
            <Setter Property="HorizontalAlignment" Value="Stretch"/>
            <Setter Property="VerticalAlignment" Value="Stretch"/>
            <Setter Property="HorizontalContentAlignment" Value="Center"/>
            <Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="FontSize" Value="20"/>
        </Style>
    </Window.Styles>

    <Grid RowDefinitions="Auto,*" Margin="10">
        <TextBlock x:Name="Ecran" Text="0" FontSize="28"
                   HorizontalAlignment="Right" Margin="0,0,0,10"/>

        <UniformGrid x:Name="Touches" Grid.Row="1" Columns="4">
            <Button Content="7"/> <Button Content="8"/> <Button Content="9"/> <Button Content="C"/>
            <Button Content="4"/> <Button Content="5"/> <Button Content="6"/> <Button Content="/"/>
            <Button Content="1"/> <Button Content="2"/> <Button Content="3"/> <Button Content="*"/>
            <Button Content="0"/> <Button Content="="/> <Button Content="+"/> <Button Content="-"/>
        </UniformGrid>
    </Grid>
</Window>